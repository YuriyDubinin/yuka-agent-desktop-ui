{
  "name": "yuka-agent-desktop-ui",
  "productName": "Yuka",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop face (Electron GUI) for the Yuka agent",
  "license": "MIT",
  "author": {
    "name": "Iurii Dubinin",
    "email": "yuradubinin100@gmail.com"
  },
  "main": "dist/main/index.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n rsbuild,electron -c magenta,cyan \"rsbuild dev\" \"wait-on -d 300 tcp:127.0.0.1:5199 file:dist/main/index.cjs file:dist/preload/index.cjs && YUKA_RENDERER_URL=http://127.0.0.1:5199 electron .\"",
    "build": "electron-forge package",
    "test": "node --import ./tests/support/register.mjs --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@rsbuild/core": "^2.3.1",
    "@rsbuild/plugin-react": "^2.1.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "electron": "45.2.2",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "wait-on": "^9.5.1"
  }
}
